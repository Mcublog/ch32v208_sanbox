{
    "version": 4,
    "configurations": [
        {
            "name": "CH32V208",
            "includePath": [
                "${workspaceFolder}/app/**",
                "${workspaceFolder}/targets/ch32v208/**",
                "${workspaceFolder}/libs/third_party/wch/ch32v20x/EVT/EXAM/SRC/Core",
                "${workspaceFolder}/libs/third_party/wch/ch32v20x/EVT/EXAM/SRC/Debug",
                "${workspaceFolder}/libs/third_party/wch/ch32v20x/EVT/EXAM/SRC/Peripheral/inc"
            ],
            "defines": [
                "CH32V20x_D8W",
                "CH32V208WBU6",
                "SYSCLK_FREQ_144MHz_HSE=144000000",
                "HSE_VALUE=32000000",
                "DEBUG=DEBUG_UART1"
            ],
            "cStandard": "c11",
            "cppStandard": "c++20",
            "browse": {
                "path": [
                    "${workspaceFolder}"
                ],
                "limitSymbolsToIncludedHeaders": true,
                "databaseFilename": ""
            },
            "compileCommands": "${workspaceFolder}/build-riscv/compile_commands.json",
            "configurationProvider": "ms-vscode.cmake-tools"
        }
    ]
}
