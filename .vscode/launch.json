{
    // Перед запуском: source scripts/env.sh в шелле, из которого стартует VS Code,
    // чтобы OPENOCD / OPENOCD_CFG и MRS_GCC_DEBUGGER попали в окружение задач.
    // MRS_GCC_DEBUGGER указывает на рабочий GDB: системный gdb-multiarch
    // (sudo apt install gdb-multiarch) либо GDB из MRS, если у него есть libpython3.8.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug: DESKTOP",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Debug: MCU (WCH-LinkE)",
            "type": "cppdbg",
            "request": "launch",
            // Путь берётся из активной launch target CMake Tools
            // (build-каталог build-riscv + выбранная цель в статус-баре).
            "program": "${command:cmake.launchTargetPath}",
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "${env:MRS_GCC_DEBUGGER}",
            "miDebuggerServerAddress": "localhost:3333",
            "stopAtEntry": true,
            "externalConsole": false,
            "preLaunchTask": "OpenOCD: gdb server",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    // setupCommands выполняются до подключения к удалённой
                    // цели, поэтому monitor здесь отвечает "not supported".
                    // Реальный reset halt делает сам OpenOCD при старте
                    // (scripts/gdb_server.sh), команда оставлена на случай,
                    // если cppdbg когда-нибудь выполнит её после connect.
                    "description": "Reset and halt (best effort)",
                    "text": "monitor reset halt",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
