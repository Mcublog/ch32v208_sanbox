{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cmake",
            "label": "CMake: build active target",
            "command": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build"
            }
        },
        {
            "type": "cmake",
            "label": "CMake: clean rebuild active",
            "command": "cleanRebuild",
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build"
        },
        {
            "type": "shell",
            "label": "Flash: MCU target",
            "command": "${workspaceFolder}/scripts/flash.sh",
            "args": [
                // .openocd генерируется CMake рядом с исполняемым файлом цели,
                // поэтому путь берётся из активной launch target CMake Tools.
                "${command:cmake.launchTargetPath}.openocd"
            ],
            "group": "test",
            "presentation": {
                "reveal": "always"
            }
        },
        {
            "type": "shell",
            "label": "OpenOCD: gdb server",
            "command": "${workspaceFolder}/scripts/gdb_server.sh",
            "args": [
                // Перед отладкой прошиваем ту же цель, что загрузит отладчик.
                // Скрипт сначала останавливает старый OpenOCD (WCH-LinkE занят
                // эксклюзивно), затем flash.sh с verify, затем поднимает сервер.
                "--flash",
                "${command:cmake.launchTargetPath}.openocd"
            ],
            "isBackground": true,
            "problemMatcher": {
                "owner": "openocd",
                "fileLocation": ["relative", "${workspaceFolder}"],
                "pattern": [
                    {
                        "regexp": "^(Error) : (.*)$",
                        "file": 1,
                        "message": 2,
                        "kind": "file"
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^\\[gdb-server\\]|^Info : starting gdb server",
                    "endsPattern": "Listening on port [0-9]+ for gdb connections"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": false
            }
        },
        {
            "type": "shell",
            "label": "OpenOCD: stop gdb server",
            "command": "${workspaceFolder}/scripts/gdb_server.sh",
            "args": [
                "--stop"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "Delete: build dirs",
            "type": "shell",
            "linux": {
                "command": "rm",
                "args": [
                    "-rf",
                    "build",
                    "build-riscv"
                ]
            },
            "group": "build",
            "presentation": {
                "reveal": "silent"
            }
        }
    ]
}
